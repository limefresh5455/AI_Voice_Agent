# Docker Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Required: Deepgram API Key for Speech-to-Text and Text-to-Speech
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Required: AWS Credentials for Bedrock LLM
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Model Selection (choose based on your needs and budget)
AWS_BEDROCK_MODEL_ID=deepseek.deepseek-r1-distill-qwen-32b

# Optional: Twilio (for phone call support)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Salesforce (for production integration)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
SF_INSTANCE_URL=

# Security (change in production!)
SECRET_KEY=change-this-secret-key-in-production

# CORS Origins (add your frontend URL if different)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Call Settings
MAX_CALL_DURATION_SECONDS=7200
CALL_RECORDING_ENABLED=true
